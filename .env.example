LOG_LEVEL=NONE
ZUSTAND_DEV_TOOLS=false
PBIVIZ_DEV_MODE=false
PBIVIZ_DEV_OVERLAY=false
PBIVIZ_VIEWPORT_GATE_OVERLAY=false
PBIVIZ_DEV_FORCE_READ_MODE=false
ALLOW_EXTERNAL_URI=false
# Optional: point vega/vega-lite at a local build for testing (see
# docs/DEVELOPMENT.md "Testing local builds of Vega and Vega-Lite").
# Leave unset/blank for normal development and ALL packaged builds.
# VEGA_LOCAL_PATH=C:/Repos/vega/packages/vega/build/vega.module.js
# VEGA_LITE_LOCAL_PATH=C:/Repos/vega-lite/build/vega-lite.js