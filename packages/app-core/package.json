{
    "name": "@deneb-viz/app-core",
    "version": "2.0.0",
    "author": "Deneb contributors",
    "description": "Provides the core functionality for a Deneb application.",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deneb-viz/deneb.git"
    },
    "packageManager": "npm@10.3.0",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "clean": "rimraf dist",
        "dev": "tsdown --watch",
        "prepack": "npm run build",
        "typecheck": "tsc --noEmit",
        "eslint": "node ../../bin/workspace-eslint.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "files": [
        "dist/**"
    ],
    "sideEffects": false,
    "devDependencies": {
        "@deneb-viz/eslint-config": "*",
        "@deneb-viz/typescript-config": "*",
        "@types/node": "^22.15.33",
        "@types/react": "^19.0.0",
        "tsdown": "0.23.0",
        "typescript": "^5.6.2",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@deneb-viz/data-core": "*",
        "@deneb-viz/json-processing": "*",
        "@deneb-viz/template-usermeta": "*",
        "@deneb-viz/utils": "*",
        "@fabric-msft/svg-icons": "^7.0.0",
        "@uidotdev/usehooks": "^2.4.1",
        "d3-format": "^2.0.0",
        "d3-time-format": "^3.0.0",
        "fast-equals": "^5.3.3",
        "mergician": "^2.0.2",
        "overlayscrollbars": "^2.10.1",
        "overlayscrollbars-react": "^0.5.6",
        "react-dropzone": "14.2.3",
        "zustand": "^4.5.5"
    },
    "peerDependencies": {
        "@deneb-viz/powerbi-compat": "*",
        "@deneb-viz/vega-react": "*",
        "@deneb-viz/vega-runtime": "*",
        "@fluentui/react-components": "^9.72.6",
        "@fluentui/react-icons": "^2.0.313",
        "powerbi-visuals-api": "5.11.0",
        "powerbi-visuals-utils-formattingutils": "^6.1.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vega": ">=5",
        "vega-lite": ">=5"
    }
}
