{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["^build", "@deneb-viz/app-core#build"],
            "outputs": ["dist/**"]
        },
        "test": {
            "dependsOn": ["^build", "@deneb-viz/app-core#build"],
            "outputs": ["coverage/**"]
        },
        "bench": {
            "dependsOn": ["^build", "@deneb-viz/app-core#build"],
            "cache": false
        }
    }
}
