{
    "extends": "@deneb-viz/typescript-config/react-library.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "isolatedModules": false,
        "preserveConstEnums": false,
        "strict": false,
        "alwaysStrict": true,
        "types": ["node", "react", "react-dom"]
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.*",
        "**/*.spec.*",
        "src/__test__/**",
        "src/__tests__/**",
        "src/**/__test__/**"
    ]
}
