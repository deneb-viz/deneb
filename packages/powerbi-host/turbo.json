{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build",
                "@deneb-viz/app-core#build",
                "@deneb-viz/template-usermeta#build"
            ],
            "outputs": ["dist/**"]
        },
        "test": {
            "dependsOn": [
                "^build",
                "@deneb-viz/app-core#build",
                "@deneb-viz/template-usermeta#build"
            ],
            "outputs": ["coverage/**"]
        }
    }
}
